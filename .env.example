# ===================================================================
# PAYPAL DEVELOPER SANDBOX CONFIGURATION
# ===================================================================
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_registered_sandbox_webhook_id_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ===================================================================
# AI ENGINE / LLM CONFIGURATION (Supports OpenAI OR Google Gemini)
# ===================================================================
# Cách 1 (OpenAI): Điền sk-proj-... và LLM_MODEL=gpt-4o-mini
# Cách 2 (Gemini): Dán key AIzaSy... vào OPENAI_API_KEY hoặc GEMINI_API_KEY và LLM_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_or_compatible_api_key_here
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# ===================================================================
# APPLICATION & DATABASE CONFIGURATION
# ===================================================================
PORT=8000
DATABASE_URL="file:./dev.db"
CORS_ORIGINS="http://localhost:3000,https://*.render.com"

# ===================================================================
# FRONTEND PUBLIC CONFIGURATION
# ===================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here

